{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noEmit": true, "skipLibCheck": true, "types": ["node"],
    "allowImportingTsExtensions": true, "erasableSyntaxOnly": true
  },
  "include": ["scripts/**/*.ts"]
}
