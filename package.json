{
  "name": "altyapi-3d-gis",
  "version": "37.0.0",
  "private": true,
  "type": "module",
  "description": "Ankara Kent Rehberi için ArcGIS 5.1 component-first, uçtan uca strict TypeScript 7 kaynak mimarisi; TypeScript boot/PWA worker üretimi, atomik katman aktivasyonu, ağ/sağlık/latency duyarlı yükleme, gerçek in-flight iptal, canlı provider/LayerView doğrulaması, güvenli WMS/WFS failover, onaylı-IP TUCBS uzlaştırması ve modern offline-safe teslimat sunan profesyonel 3B CBS platformu.",
  "scripts": {
    "dev": "npm run build:sw && vite --host 127.0.0.1 --port 4173",
    "dev:host": "npm run build:sw && vite --host 0.0.0.0 --port 4173",
    "start": "npm run dev",
    "build": "npm run typecheck && npm run build:sw && vite build && tsx scripts/verify-build.ts",
    "build:sw": "tsx scripts/build-service-worker.ts",
    "build:watch": "vite build --watch",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:host": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "npm run typecheck:app && npm run typecheck:worker",
    "typecheck:app": "tsc -b --pretty false",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit --pretty false",
    "pretest": "npm run build:sw",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:dependencies": "tsx scripts/validate-dependencies.ts",
    "validate:source": "tsx scripts/validate-source-language.ts",
    "validate:services": "tsx scripts/validate-services.ts",
    "verify:build": "tsx scripts/verify-build.ts",
    "check": "npm run validate:dependencies && npm run validate:source && npm run validate:services && npm run validate:health && npm run validate:navigation && npm run test && npm run build",
    "validate:health": "tsx scripts/validate-service-health.ts",
    "probe:services": "tsx scripts/probe-service-health.ts",
    "validate:navigation": "tsx scripts/validate-service-navigation.ts",
    "audit:scales": "tsx scripts/audit-service-scales.ts && tsx scripts/finalize-scale-audit.ts",
    "validate:scale-audit": "tsx scripts/validate-scale-audit.ts",
    "summary:observability": "tsx scripts/write-observability-summary.ts"
  },
  "dependencies": {
    "@arcgis/core": "5.1.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@arcgis/map-components": "5.1.26",
    "@esri/calcite-components": "^5.1.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "@types/node": "^24.10.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
