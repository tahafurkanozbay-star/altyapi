{
  "name": "altyapi-3d-gis",
  "version": "19.0.0",
  "private": true,
  "type": "module",
  "description": "Ankara Kent Rehberi için ArcGIS 5.1 component-first, uçtan uca strict TypeScript, canlı provider ölçek uzlaştırması, katman bazlı zoom kilitleri, semantik yüksek görünürlük render sistemi, WMS/WFS failover, adaptif servis kurtarma ve onaylı-IP TUCBS erişimi içeren profesyonel 3B CBS platformu.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "dev:host": "vite --host 0.0.0.0 --port 4173",
    "start": "npm run dev",
    "build": "tsc -b && vite build && tsx scripts/verify-build.ts",
    "build:watch": "vite build --watch",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:host": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:services": "tsx scripts/validate-services.ts",
    "verify:build": "tsx scripts/verify-build.ts",
    "check": "npm run validate:services && npm run validate:health && npm run validate:navigation && npm run typecheck && npm run test && npm run build",
    "validate:health": "tsx scripts/validate-service-health.ts",
    "probe:services": "tsx scripts/probe-service-health.ts",
    "validate:navigation": "tsx scripts/validate-service-navigation.ts",
    "audit:scales": "tsx scripts/audit-service-scales.ts"
  },
  "dependencies": {
    "@arcgis/core": "^5.1.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@arcgis/map-components": "^5.1.25",
    "@esri/calcite-components": "^5.1.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "@types/node": "^24.10.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
