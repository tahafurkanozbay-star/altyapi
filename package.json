{
  "name": "altyapi-3d-gis",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "Ankara odaklı, performans uyarlamalı profesyonel 3B CBS komuta ve koordinasyon platformu.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "dev:host": "vite --host 0.0.0.0 --port 4173",
    "start": "npm run dev",
    "build": "tsc -b && vite build && node scripts/verify-build.mjs",
    "build:watch": "vite build --watch",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:host": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:services": "node scripts/validate-services.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run validate:services && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@arcgis/core": "^5.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
