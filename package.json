{
  "name": "altyapi-3d-gis",
  "version": "13.0.0",
  "private": true,
  "type": "module",
  "description": "Ankara odaklı, Comfort White arayüzlü, ArcGIS 5.1 component-first Scene mimarisi, adaptif stabilizasyon, doğrulanmış çalışma extentleri, ölçek guardrail'leri ve runtime güvenilirliği içeren profesyonel 3B CBS platformu.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "dev:host": "vite --host 0.0.0.0 --port 4173",
    "start": "npm run dev",
    "build": "tsc -b && vite build && node scripts/verify-build.mjs",
    "build:watch": "vite build --watch",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:host": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:services": "node scripts/validate-services.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run validate:services && npm run validate:health && npm run validate:navigation && npm run typecheck && npm run test && npm run build",
    "validate:health": "node scripts/validate-service-health.mjs",
    "probe:services": "node scripts/probe-service-health.mjs",
    "validate:navigation": "node scripts/validate-service-navigation.mjs",
    "audit:scales": "node scripts/audit-service-scales.mjs"
  },
  "dependencies": {
    "@arcgis/core": "^5.1.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@arcgis/map-components": "^5.1.24",
    "@esri/calcite-components": "^5.1.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "@types/node": "^24.10.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
