{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/platform/runtimeEvents.ts",
    "src/platform/citizenExperienceSupervisor.ts",
    "src/lib/urlState.ts",
    "src/lib/workspaceView.ts",
    "src/lib/globalShortcutGuard.ts",
    "src/lib/citizenReadiness.ts",
    "src/lib/attributeTable.ts",
    "src/lib/layerExplorerState.ts"
  ]
}
